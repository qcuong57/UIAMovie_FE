{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/:path*",
      "destination": "https://uiamovie-be.onrender.com/api/:path*"
    },
    {
      "source": "/movie/:id/info",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Discordbot|Zalo|Applebot|bingbot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot).*"
        }
      ],
      "destination": "/api/og?type=movie&id=:id"
    },
    {
      "source": "/movie/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Discordbot|Zalo|Applebot|bingbot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot).*"
        }
      ],
      "destination": "/api/og?type=movie&id=:id"
    },
    {
      "source": "/tvshow/:id/info",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Discordbot|Zalo|Applebot|bingbot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot).*"
        }
      ],
      "destination": "/api/og?type=tvshow&id=:id"
    },
    {
      "source": "/tvshow/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Discordbot|Zalo|Applebot|bingbot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot).*"
        }
      ],
      "destination": "/api/og?type=tvshow&id=:id"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://image.tmdb.org; media-src 'self' blob: https://res.cloudinary.com; worker-src 'self' blob:; connect-src 'self' https://uiamovie-be.onrender.com wss://uiamovie-be.onrender.com https://res.cloudinary.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}